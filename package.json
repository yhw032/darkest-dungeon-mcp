{
  "name": "darkest-dungeon-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for Darkest Dungeon 1 save data and gameplay knowledge",
  "type": "module",
  "bin": {
    "darkest-dungeon-mcp": "dist/mcp/stdio.js"
  },
  "files": [
    "dist",
    "data",
    "docs",
    "samples",
    "tools/README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "start": "node dist/mcp/stdio.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:package": "npm run build && tsx --test tests/package.test.ts"
  },
  "keywords": [
    "darkest-dungeon",
    "mcp",
    "model-context-protocol"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  }
}
