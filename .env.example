# Directory containing persist.roster.json, persist.estate.json,
# persist.town.json, persist.quest.json, and persist.upgrades.json.
DD_SAVE_DIR=C:\path\to\Steam\userdata\STEAM_USER_ID\262060\remote\profile_0

# Darkest Dungeon installation directory. Required for building upgrade costs.
DD_GAME_DIR=C:\path\to\Steam\steamapps\common\DarkestDungeon

# Optional when the decoder is stored at tools/DDSaveEditor.jar.
# DD_SAVE_EDITOR_JAR=C:\path\to\DDSaveEditor.jar

